<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Heatmaps with Other Worlds palettes</title>
  <style>
    body { color: #25314f; font-family: system-ui, sans-serif; line-height: 1.55;
      margin: 2rem auto; max-width: 920px; padding: 0 1rem; }
    h1, h2 { color: #182541; }
    code { background: #f2efe8; padding: .1rem .25rem; }
